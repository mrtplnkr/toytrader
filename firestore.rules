service cloud.firestore {
  // Omniva's own technical docs accept barcodes between 5 and 30 characters
  // (a real one is typically 13, e.g. CC730129455EE) - doesn't verify the
  // barcode is real, just rejects obvious typos/junk at the rules level too,
  // matching the same check already done client-side before submission.
  function validBarcodeOrAbsent(data, field) {
    return !(field in data) ||
      (data[field] is string && data[field].size() >= 5 && data[field].size() <= 30);
  }

  function isBanned(database, uid) {
    return exists(/databases/$(database)/documents/bannedUsers/$(uid));
  }

 match /databases/{database}/documents {
    match /offers/{offerId} {
      // A phone number can live on an offer now (offerShippingPhone/
      // targetShippingPhone, self-reported alongside the barcode fields) -
      // meaningfully more sensitive than anything else here, so unlike the
      // rest of this app's open-read model, only the two participants and
      // admins can read an offer back.
      allow read: if request.auth.uid != null &&
        (request.auth.uid == resource.data.userInitiated ||
         request.auth.uid == resource.data.userReceived ||
         request.auth.token.admin == true);
      allow create: if request.auth.uid != null && !isBanned(database, request.auth.uid);
      // Only the tip payment fields stay server-only (verified via Stripe
      // webhook/recheck) - the tip is per-trade now, not per-side, so a
      // single shared set of fields. Barcode/terminal/size/status are
      // self-reported by the user who manually registered their own
      // shipment on Omniva's site - same trust model as offerAccepted/
      // offerPosted/offerReceived, which have always been client-writable.
      allow update: if request.auth.uid != null &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'tipPaid', 'tipStripeSessionId', 'tipPaidByUid'
        ]) &&
        validBarcodeOrAbsent(request.resource.data, 'offerShipmentBarcode') &&
        validBarcodeOrAbsent(request.resource.data, 'targetShipmentBarcode');
      allow delete: if request.auth.uid != null;
    }
    match /mail/{docId} {
      allow read, write: if false;
    }
    match /bannedUsers/{uid} {
      allow read: if request.auth.uid != null;
      allow write: if false;
      // Admin SDK only (functions/src/admin.ts's banUser/unbanUser) -
      // checked by isBanned() above on toys/offers writes.
    }
    match /toys/{toyId} {
      allow read: if request.auth.uid != null;
      allow create, update, delete: if request.auth.uid != null && !isBanned(database, request.auth.uid);
    }
    match /ratings/{ratingId} {
      allow read: if request.auth.uid != null;
      allow create: if request.auth.uid != null &&
        request.resource.data.raterUid == request.auth.uid;
      allow update, delete: if false;
    }
    match /shippingProfiles/{uid} {
      // A user's own reusable default (name/phone/preferred parcel
      // machine) - fully private, never read directly by anyone else.
      // Sharing it on a specific trade means copying it onto that offer's
      // own ${side}Shipping* fields instead (see /offers above).
      allow read, write: if request.auth.uid != null && request.auth.uid == uid;
    }
    match /fcmTokens/{token} {
      // One doc per push-notification registration token (a user can have
      // several, one per device/browser). Only the owning user can register
      // or remove their own tokens - sending (functions/src/notifications.ts)
      // happens via the Admin SDK, which bypasses rules entirely.
      allow read, delete: if request.auth.uid != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth.uid != null && request.auth.uid == request.resource.data.uid;
      allow update: if false;
    }
    match /omnivaCache/{docId} {
      allow read: if request.auth.uid != null;
      allow write: if false;
    }
    match /complaints/{complaintId} {
      // May name someone else and describe a dispute - only the person who
      // filed it or an admin should be able to read it back, unlike the
      // mostly-open read model the rest of this app uses.
      allow read: if request.auth.uid != null &&
        (request.auth.uid == resource.data.reporterUid || request.auth.token.admin == true);
      allow create: if request.auth.uid != null &&
        request.resource.data.reporterUid == request.auth.uid;
      allow update, delete: if false;
    }
    // Firestore evaluates every match block that applies to a path and
    // grants access if ANY of them allows it - a document matching both
    // this catch-all and one of the dedicated blocks above is governed by
    // whichever is more permissive, not "most specific wins". So every
    // collection with its own tighter rule above must be excluded here too,
    // or this catch-all silently re-grants what the dedicated block denies
    // (this is exactly how the ratings/mail rules above were previously
    // being bypassed - mail was openly readable, ratings openly writable).
 		match /{collectionName}/{doc}{
      allow read : if request.auth.uid != null &&
        !(collectionName in ['mail', 'complaints', 'offers', 'shippingProfiles', 'fcmTokens']);
      allow write : if request.auth.uid != null &&
        !(collectionName in ['offers', 'mail', 'ratings', 'bannedUsers', 'toys', 'complaints',
          'shippingProfiles', 'omnivaCache', 'fcmTokens']);
    }
  }
  //match /databases/{database}/documents {
    //match /{document=**} {
      // This rule allows anyone with your database reference to view, edit,
      // and delete all data in your database. It is useful for getting
      // started, but it is configured to expire after 30 days because it
      // leaves your app open to attackers. At that time, all client
      // requests to your database will be denied.
      //
      // Make sure to write security rules for your app before that time, or
      // else all client requests to your database will be denied until you
      // update your rules.
      //allow read: if request.auth.uid != request.resource.data.userId;
      //allow write: if request.auth != null;
    //}
  //}
}
